---

---
<div class="min-h-screen flex flex-cols justify-center w-full border border-t-0 border-lightcharcoal">

    <div class="side-bar sticky top-0 h-screen font-serif text-lightcharcoal border-r border-t-0 w-1/9 md:w-1/12  border-lightcharcoal flex items-center justify-center">
        <span class="-rotate-90 text-sm md:text-lg tracking-[0.8rem] font-medium whitespace-nowrap">
            CONTACT
        </span>
    </div>

        <!--mobile -->
    <div class="md:hidden relative w-full min-h-screen flex flex-col flex-1 gap-4 py-24 px-6 md:px-36 text-heading font-sans">
            <img src="/img/lamp-pic.png" alt="lamp photo"
                    class="absolute inset-0 w-full h-full  object-cover -z-10"/>

            <form class=" relative w-full  flex flex-col gap-10 pt-60 justify-center text-heading items-center">
                <h2 class="text-3xl md:text-4xl font-serif italic tracking-widest">Leave your note</h2>
                
                <div class="w-full p-6 flex flex-col gap-10">
                    <div class="flex w-full text-heading flex-col gap-4">
                        <label for="name" class="font-sans tracking-[0.3rem] text-lg">Name:</label>
                        <input id="name" name="name" type="text" 
                                class="h-10 w-full py-2 font-serif text-base bg-transparent px-4 focus:outline-none border-b border-lightcharcoal/60"
                                placeholder="Your name"/>
                    </div>
                    <div class="flex w-full text-heading flex-col gap-4">
                        <label for="message" class="font-sans tracking-[0.3rem]  text-lg">Your message:</label>
                        <textarea id="message" name="message"
                                class="h-auto w-full font-seriftext-base py-2 px-4 bg-transparent focus:outline-none border-b border-lightcharcoal/60"
                                placeholder="Share your thought..."/>
                    </div>
                </div>
                <div class="w-full px-6">
                    <button class="w-full border border-lightcharcoal rounded-sm tracking-widest p-2 text-xl bg-warmhover text-bg hover:text-heading hover:bg-transparent hover:shadow-lg duration-300  font-sans font-medium">Send Message</button>
                </div>
            </form>

            
    </div>
   
        <!--desktop -->
        <div class="hidden md:block relative flex-1 min-h-screen py-24 px-36 text-heading font-sans">
        <img src="/img/lamp-pic.png" alt="lamp photo" 
                class="absolute inset-0 w-full h-full object-top object-cover -z-10" />

        <form class="pt-95 flex flex-col items-center justify-center gap-10 md:gap-16">
            <h2 class="text-5xl font-serif italic tracking-widest">Leave your note</h2>
            <div class="w-2/3 h-full p-6 flex flex-col gap-16 mb-2">
                    <div class="flex w-full text-heading flex-col gap-4">
                        <label for="name" class="font-sans tracking-[0.3rem] text-xl">Name:</label>
                        <input id="name" name="name" type="text" 
                                class="h-10 w-full py-2 font-serif text-base bg-transparent px-4 focus:outline-none border-b border-lightcharcoal/60"
                                placeholder="Your name"/>
                    </div>
                    <div class="flex w-full text-heading flex-col gap-4">
                        <label for="message" class="font-sans tracking-[0.3rem] text-xl">Your message:</label>
                        <textarea id="message" name="message"
                                class="h-auto w-full font-seriftext-base py-2 px-4 bg-transparent focus:outline-none border-b border-lightcharcoal/60"
                                placeholder="Share your thought..."/>
                    </div>
                </div>
                <div class="w-full flex justify-center px-6">
                    <button class="w-1/3  border border-lightcharcoal rounded-sm tracking-widest p-2 text-xl hover:bg-warmhover hover:text-bg text-heading bg-transparent shadow-lg duration-300  font-sans font-medium">Send Message</button>
                </div>
        </form>

        <button class="relative z-10"></button>
    </div>
</div>