---

---
<div id="subscribe" class="h-auto md:-h-screen flex flex-cols justify-center w-full border border-t-0 border-lightcharcoal">

    <div class="side-bar sticky top-0  font-serif text-lightcharcoal border-r border-t-0 w-1/9 md:w-1/12 border-lightcharcoal flex items-center justify-center">
        <span class="-rotate-90 text-sm md:text-lg tracking-[0.8rem] font-medium whitespace-nowrap">
            SUBSCRIBE
        </span>
    </div>

    <!--mobile -->
    <div class="md:hidden relative w-full h-auto flex flex-col flex-1 gap-4 py-10 px-6 text-heading font-sans">
        <img src="/img/lamp-pic.png" alt="lamp photo"
                class="absolute inset-0 w-full h-full object-cover -z-10"/>

        <form id="subscribe-form-mobile" class="relative w-full flex flex-col gap-10 pt-60 justify-center text-heading items-center">
            <h2 class="text-3xl text-center md:text-4xl font-serif italic tracking-widest">
                New recipes <br>in your inbox</h2>
            
            <div class="w-full p-6 flex flex-col gap-10">
                <div class="flex w-full text-heading flex-col gap-4">
                    <label for="email-mobile" class="font-sans tracking-[0.3rem] text-lg">Your email:</label>
                    <input id="email-mobile" name="email" type="email"
                            class="h-10 w-full py-2 font-serif text-base bg-transparent px-4 focus:outline-none border-b border-lightcharcoal/60"
                            placeholder="your@email.com"/>
                </div>
            </div>
            <div class="w-full px-6">
                <button type="submit" class="w-full border border-lightcharcoal rounded-sm tracking-widest p-2 text-xl bg-warmhover text-bg hover:text-heading hover:bg-transparent hover:shadow-lg duration-300 font-sans font-medium">Subscribe</button>
            </div>
            <span id="msg-mobile" class="text-sm font-sans tracking-wide hidden"></span>
            <span class="text-lightcharcoal text-base">Your data is private and will never be shared or sold.</span>
        </form>
    </div>

    <!--desktop -->
    <div class="hidden md:block relative flex-1 min-h-screen py-24 px-36 text-heading font-sans">
        <img src="/img/lamp-pic.png" alt="lamp photo"
                class="absolute inset-0 w-full h-full object-top object-cover -z-10" />

        <form id="subscribe-form-desktop" class="pt-95 flex flex-col my-10 items-center justify-center gap-10 md:gap-16">
            <h2 class="text-5xl font-serif italic tracking-widest">New recipes in your inbox</h2>
            <div class="w-2/3 h-full p-6 flex flex-col gap-16 mb-2">
                <div class="flex w-full text-heading flex-col gap-4">
                    <label for="email-desktop" class="font-sans tracking-[0.3rem] text-xl">Your email:</label>
                    <input id="email-desktop" name="email" type="email"
                            class="h-10 w-full py-2 font-serif text-base bg-transparent px-4 focus:outline-none border-b border-lightcharcoal/60"
                            placeholder="your@email.com"/>
                </div>
            </div>
            <div class="w-full flex justify-center px-6">
                <button type="submit" class="w-1/3 border border-lightcharcoal rounded-sm tracking-[0.3rem] p-2 text-2xl hover:bg-warmhover hover:text-bg text-heading bg-transparent shadow-lg duration-300 font-sans font-medium">
                    Subscribe</button>
            </div>
            <span id="msg-desktop" class="text-sm font-sans tracking-wide hidden"></span>
            <span class="text-lightcharcoal text-base">Your data is private and will never be shared or sold.</span>
        </form>
    </div>
</div>

<script>
  async function handleSubmit(formId: string, inputId: string, msgId: string) {
    const form = document.getElementById(formId) as HTMLFormElement;
    const msg = document.getElementById(msgId) as HTMLSpanElement;
    if (!form) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const input = document.getElementById(inputId) as HTMLInputElement;
      const email = input.value.trim();

      if (!email) return;

      const button = form.querySelector('button') as HTMLButtonElement;
      button.disabled = true;
      button.textContent = 'Subscribing...';

      try {
        const res = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email })
        });

        const data = await res.json();
        msg.classList.remove('hidden');

        if (res.ok) {
          msg.textContent = 'You\'re in. Welcome to the kitchen.';
          msg.classList.add('text-green-700');
          input.value = '';
          button.textContent = 'Subscribed';
        } else if (res.status === 409) {
          msg.textContent = 'This email is already subscribed.';
          msg.classList.add('text-warmhover');
          button.disabled = false;
          button.textContent = 'Subscribe';
        } else {
          msg.textContent = 'Something went wrong. Please try again.';
          msg.classList.add('text-red-700');
          button.disabled = false;
          button.textContent = 'Subscribe';
        }
      } catch {
        msg.classList.remove('hidden');
        msg.textContent = 'Something went wrong. Please try again.';
        msg.classList.add('text-red-700');
        button.disabled = false;
        button.textContent = 'Subscribe';
      }
    });
  }

  handleSubmit('subscribe-form-mobile', 'email-mobile', 'msg-mobile');
  handleSubmit('subscribe-form-desktop', 'email-desktop', 'msg-desktop');
</script>