---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const journals = await getCollection('journals');
  return journals.map((journal) => ({
    params: { slug: journal.id },
    props: { journal },
  }));
}

const { journal } = Astro.props;
const { Content } = await render(journal);
const dateObj = new Date(journal.data.date);
const day = dateObj.toLocaleDateString('en-US', { day: '2-digit' });
const month = dateObj.toLocaleDateString('en-US', { month: 'long' });
const year = dateObj.getFullYear();
---
<Layout>
  <Navbar/>
  <main class="flex h-full w-screen gap-2">
      <img src={journal.data.image}
            class="h-screen sticky w-30 md:w-60 object-cover"/>
      <div class="content flex flex-col gap-10 items-start w-full min-w-0 py-16  md:px-20">
        
        <div class="date flex items-start gap-2">
          <span class="text-4xl font-sans text-heading">{day}</span>
          <div class="flex flex-col font-sans tracking-widest leading-tight text-xs text-heading pt-1">
            <span>{month}</span>
            <span>{year}</span>
          </div>
        </div>

        <div class="h-0.5 w-30 bg-lightcharcoal/60"></div>

        <h1 class="text-4xl md:text-6xl w-full md:leading-18 font-serif tracking-wide leading-12 text-heading">{journal.data.title}</h1>
      </div>
  </main>
</Layout>