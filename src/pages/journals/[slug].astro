---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const journals = await getCollection('journals');
  return journals.map((journal) => ({
    params: { slug: journal.id },
    props: { journal },
  }));
}

const { journal } = Astro.props;
const { Content } = await render(journal);
const dateObj = new Date(journal.data.date);
const day = dateObj.toLocaleDateString('en-US', { day: '2-digit' });
const month = dateObj.toLocaleDateString('en-US', { month: 'long' });
const year = dateObj.getFullYear();
---
<Layout>
  <Navbar/>
  <main class="flex h-screen w-screen overflow-hidden gap-2">
      <div class="h-screen w-30 md:w-80 shrink-0 sticky top-0 overflow-hidden">
        <img src={journal.data.image}
             class="h-full w-full object-cover"/>
    </div>
      
      <div class="content w-full overflow-y-auto h-screen flex flex-col gap-10 items-start py-16 px-4  md:px-26">
        
        <div class="date flex text-lightcharcoal items-start gap-2">
          <span class="text-4xl font-sans">{day}</span>
          <div class="flex flex-col font-sans tracking-widest leading-tight text-xs pt-1">
            <span>{month}</span>
            <span>{year}</span>
          </div>
        </div>

        <div class="h-0.5 w-30 bg-lightcharcoal/60 shrink-0"></div>

        <div class="flex flex-col gap-10">
          <h1 class="text-4xl md:text-6xl w-full md:leading-18 font-serif tracking-wide leading-12 text-heading">{journal.data.title}</h1>
          <div class="writing-content w-full   pr-2 md:p-0 text-heading text-base md:text-lg font-sans tracking-normal">
           <Content/>
        </div>
        </div>

        <div class="h-0.5 w-30 bg-lightcharcoal/60 shrink-0"></div>

        <div class="credit w-full tracking-wide pr-6 flex flex-row justify-between">
          <div class="author flex flex-col gap-2">
            <span class=" text-heading text-base md:text-lg font-sans">Written by</span>
            <span class="font-serif text-lg text-heading font-semibold">The Gentle Kitchen</span>
          </div>

          <div class="pic flex flex-col gap-2">
            <span class=" text-heading text-base md:text-lg font-sans">Picture</span>
            <span class="font-serif text-lg text-heading font-semibold">Pinterest</span>
          </div>
        </div>
        <a href="/journals">
                <button class="hover:tracking-[0.4rem] transition-all duration-300 cursor-pointerborder shadown-md border border-lightcharcoal/80 rounded-xs px-6 py-2 s hover:bg-warmhover hover:text-white  text-heading font-sans tracking-[0.2rem]">All Journals</button>
            </a>
      </div>

      
  </main>
</Layout>