---
import Layout from "../../layouts/Layout.astro"
import Navbar from "../../components/Navbar.astro";
import { getCollection } from "astro:content";
const recipes = await getCollection('recipes');
---

<Layout>
    <Navbar/>
    <main class="min-h-screen w-full flex flex-col gap-10 py-12 px-4 md:p-24">
     
        <div class="top w-full flex justify-between items-stretch">
            <div class="left-content w-2/3 flex flex-col gap-6 md:gap-10">
                <h1 class="text-4xl md:text-6xl md:leading-18 font-serif  tracking-[0.5rem] leading-12 text-heading">ALL RECIPES</h1>
                <div class="dish-type flex items-center text-lightcharcoal md:text-base text-sm font-sans tracking-[0.3rem] md:tracking-[0.5rem]">
                    <span class="pr-6 cursor-pointer hover:text-warmhover" data-filter="SOUP">SOUP</span>
                    <span class="border-l cursor-pointer border-lightcharcoal pl-6 pr-6 hover:text-warmhover" data-filter="MAIN">MAIN</span>
                    <span class="border-l cursor-pointer border-lightcharcoal pl-6 hover:text-warmhover" data-filter="SIDE">SIDE</span>
                    </div>
            </div>

            <div class="side-bar w-8 self-right font-serif  text-lightcharcoal flex items-center justify-center">
        <span class="[writing-mode:vertical-rl] [text-orientation:upright] mt-2 text-sm md:text-lg tracking-[0.8rem] font-medium">
            HOME FOOD
        </span>
    </div>
        </div>

        <div class="recipe-cards w-full mt-4 flex flex-col justtify-center gap-8">
            <div class="tagline w-full text-base mb-4 md:text-lg text-lightcharcoal leading-relaxed font-sans font-light tracking-widest">
                <span>Cooking without the performance.</span><br>
                <span>Here are our recipes for comfort foods.</span>
            </div>

            <div class="card-grid w-full justify-center grid grid-cols-2 gap-6 md:gap-16 md:grid-cols-4">
                {recipes.map((recipe) => (
                    <a href={`/recipes/${recipe.id}`} data-category={recipe.data.category}>
                    <div class= "md:h-90 h-70 flex flex-col gap-4 hover:scale-110 duration-300 border border-lightcharcoal md:p-6 p-3">
                        <img src={recipe.data.image}
                                class="h-3/4 w-full object-cover drop-shadow-sm"/>
                       <div class="flex justify-between mt-2 md:mt-4"> 
                        <h3 class="text-heading flex items-center md:text-xl  font-serif italic">{recipe.data.title}</h3>
                        <div class="tag bg-lightcharcoal/20 px-2 py-1 flex justify-center items-center rounded-full w-fit">
                            <span class="font-sans text-heading/80 font-medium tracking-[0.2rem] text-xs">{recipe.data.category}</span>
                        </div>
                       </div>
                    </div>
                    </a>
  ))}
            </div>

            <div class="flex items-center justify-center gap-4 font-sans mt-6">
        <button id="prev-journal" aria-label="Previous" class="w-9 h-9 flex items-center justify-center border border-lightcharcoal rounded-full text-lightcharcoal hover:bg-button hover:text-bg transition-colors">←</button>
        <span id="journal-dots" class="flex gap-1"></span>
        <button id="next-journal" aria-label="Next" class="w-9 h-9 flex items-center justify-center border border-lightcharcoal rounded-full text-lightcharcoal hover:bg-button hover:text-bg transition-colors">→</button>
    </div>
        </div>
    </main>
</Layout>

<script>
    const filters = document.querySelectorAll('[data-filter]');
    const cards = Array.from(document.querySelectorAll('[data-category]'));
    let activeFilter: string | null = null;

    const PAGE_SIZE = 8;
    let currentPage = 0;

    function getVisibleCards() {
        return cards.filter((card) =>
            !activeFilter || card.getAttribute('data-category') === activeFilter
        );
    }

    function renderPage() {
        const visible = getVisibleCards();
        const totalPages = Math.max(1, Math.ceil(visible.length / PAGE_SIZE));
        currentPage = Math.min(currentPage, totalPages - 1);

        cards.forEach((card) => card.classList.add('hidden'));

        const start = currentPage * PAGE_SIZE;
        visible.slice(start, start + PAGE_SIZE).forEach((card) => card.classList.remove('hidden'));

        const dotsEl = document.getElementById('journal-dots');
        if (dotsEl) {
            dotsEl.innerHTML = '';
            for (let i = 0; i < totalPages; i++) {
                const dot = document.createElement('span');
                dot.className = `w-2 h-2 rounded-full ${i === currentPage ? 'bg-warmhover' : 'bg-lightcharcoal/40'}`;
                dotsEl.appendChild(dot);
            }
        }

        const prevBtn = document.getElementById('prev-journal') as HTMLButtonElement;
        const nextBtn = document.getElementById('next-journal') as HTMLButtonElement;
        if (prevBtn) prevBtn.disabled = currentPage === 0;
        if (nextBtn) nextBtn.disabled = currentPage === totalPages - 1;
    }

    filters.forEach((filter) => {
        filter.addEventListener('click', () => {
            const value = filter.getAttribute('data-filter');
            activeFilter = activeFilter === value ? null : value;
            currentPage = 0;

            filters.forEach((f) => f.classList.toggle('text-warmhover', f.getAttribute('data-filter') === activeFilter));
            renderPage();
        });
    });

    document.getElementById('prev-journal')?.addEventListener('click', () => {
        currentPage = Math.max(0, currentPage - 1);
        renderPage();
    });

    document.getElementById('next-journal')?.addEventListener('click', () => {
        currentPage += 1;
        renderPage();
    });

    renderPage();
</script>